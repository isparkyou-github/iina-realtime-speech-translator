{
  "name": "Realtime Speech Translator",
  "version": "1.2.0",
  "identifier": "dev.codex.iina.realtime-speech-translator",
  "author": {
    "name": "Codex"
  },
  "description": "Transcribe the playing audio in near real time, translate it, and render the result as an overlay.",
  "entry": "main.js",
  "preferencesPage": "preferences.html",
  "permissions": [
    "show-osd",
    "video-overlay",
    "network-request",
    "file-system"
  ],
  "allowedDomains": [
    "*"
  ],
  "preferenceDefaults": {
    "enabled": true,
    "apiKey": "",
    "asrBackend": "local-helper",
    "helperUrl": "http://127.0.0.1:8765",
    "helperPythonPath": "python3",
    "helperScriptPath": "",
    "localAsrModel": "base",
    "localAsrDevice": "auto",
    "localAsrComputeType": "auto",
    "localAsrWindowSeconds": 2,
    "localAsrStrideSeconds": 0.7,
    "ffmpegPath": "",
    "curlPath": "",
    "transcriptionUrl": "https://api.openai.com/v1/audio/transcriptions",
    "transcriptionModel": "gpt-4o-mini-transcribe",
    "transcriptionPrompt": "",
    "chatUrl": "https://api.openai.com/v1/chat/completions",
    "chatModel": "gpt-4o-mini",
    "targetLanguage": "Simplified Chinese",
    "sourceLanguage": "auto",
    "showTranscript": true,
    "latencyDefaultsMigrated": false,
    "fontSize": 28,
    "bottomOffset": 9,
    "maxWidth": 82,
    "chunkSeconds": 2,
    "pollIntervalMs": 650,
    "maxCatchupSeconds": 4
  }
}
